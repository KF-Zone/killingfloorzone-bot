# Discord bot token; never commit the real value.
TOKEN=
# Discord application ID used to register slash commands.
CLIENT_ID=
# Optional test guild ID for development command registration.
GUILD_ID=
# Public origin of the Next.js/Vercel API, for example https://example.com.
WEB_API_BASE_URL=
# Same high-entropy value as BOT_API_SECRET in the Next.js deployment.
BOT_API_SECRET=
